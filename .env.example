# 复制成 .env 后按需修改：cp .env.example .env

# ---------- 端口 ----------
# 宿主机对外端口（容器内部固定监听 8211）
HOST_PORT=8211

# ---------- 上游 ----------
# 上游地址，一般不用改
ZEN_BASE_URL=https://opencode.ai/zen/v1
# 留空 = 用匿名 public 密钥，只能调免费模型（当前 11 个）
# 填入 OpenCode 账号的真实密钥后，全部 84 个模型可用，FREE_ONLY 自动失效
OPENCODE_API_KEY=

# ---------- 安全 ----------
# 密钥文件（容器内路径，对应宿主机 ./data/api-keys.txt）
# KEY_FILE=/data/api-keys.txt
# 追加临时密钥，英文逗号分隔（可选；改了这项需要重启容器）
PROXY_API_KEYS=
# IP 白名单，逗号分隔 CIDR；留空 = 不限制。例如 1.2.3.4/32,10.0.0.0/8
IP_ALLOWLIST=
# 只有在 Caddy/Nginx 反向代理后面才设为 true（直接暴露时开了可被伪造 IP）
TRUST_PROXY=false
# 每把密钥每分钟最大请求数，0 = 不限制
RATE_LIMIT_PER_MIN=0

# ---------- 免费层补丁 ----------
# 客户端没带 read/bash 工具时自动注入 stub（上游硬性要求，关掉纯聊天客户端会 403）
INJECT_STUB_TOOLS=true
# text = 把 stub 工具调用变成文字提示（推荐）
# drop = 直接丢弃   passthrough = 原样透传（客户端可能不认识该工具）
STUB_CALL_MODE=text
# true = 只放行免费模型
FREE_ONLY=true

# ---------- 协议桥接（Codex 这类只会说 Responses 的客户端）----------
# auto   = 下面列出的原生模型直连 /responses，其它模型自动翻译成 chat/completions；
#          上游若回 ModelProtocolUnsupported 也会自动回退重试
# native = 永远直连 /responses      bridge = 永远走翻译
RESPONSES_MODE=auto
RESPONSES_NATIVE_MODELS=muse-spark-1.2-contributor-free,muse-spark-1.3-contributor-free
# 是否把模型的思考过程(reasoning_content)也翻成 Responses 的 reasoning 事件（默认关）
BRIDGE_REASONING=false

# ---------- 工具兼容 ----------
# mirror = 把客户端自己的 shell / 读文件工具改名成上游要求的 read、bash，调用时再改回
#          客户端的工具名（推荐：Codex 的 exec_command、pi 的 bash 等 agent 工具调用链不受影响）
# stub   = 注入一个通用假工具，被调用时转成文字提示
STUB_TOOL_MODE=mirror

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_REQUESTS=true
# ACCESS_LOG=/data/access.jsonl

# ---------- 其它 ----------
# 上游超时（秒），长回答别调太小
UPSTREAM_TIMEOUT=600
# 上游 User-Agent，上游要求以 opencode/ 开头，一般不用改
UPSTREAM_UA=opencode/latest/2.0.11/cli
